#!/usr/bin/env python3
"""Save an OpenRGB profile into the motherboard's and the RAM's own memory.

OpenRGB sets colours live but never saves them to the devices, so after a
reboot the board stays dark and the RAM falls back to its default colours
until OpenRGB runs again. This tool saves the profile into both:

ASRock Polychrome USB controller (USB 26ce:01a2): the profile is converted to
the controller's built-in per-zone effects, written and committed to flash.
Protocol from OpenRGB's Controllers/ASRockPolychromeUSBController.

ENE SMBus RAM controllers ("ENE DRAM" in OpenRGB): OpenRGB's command line
programs the profile into the sticks, then each stick gets the save command
that OpenRGB's "Save To Device" button sends.
Protocol from OpenRGB's Controllers/ENESMBusController.
"""

import argparse
import ctypes
import fcntl
import glob
import json
import os
import re
import select
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


class Error(Exception):
    pass


# --------------------------------------------------------------------------- #
# ASRock Polychrome USB controller
# --------------------------------------------------------------------------- #

HID_ID = "0003:000026CE:000001A2"  # bus:vendor:product as the kernel reports it

CMD_SET_ZONE = 0x10
CMD_READ_ZONE = 0x11
CMD_COMMIT = 0x12
CMD_READ_HEADER = 0x14
CMD_WRITE_HEADER = 0x15

CFG_AVAILABLE = 0x01  # bitmask: zones present on this board
CFG_LEDCOUNT = 0x02   # one byte per zone: LED count, 0x1E = zone absent
CFG_RGSWAP = 0x03     # bitmask: zones whose red/green bytes are swapped

ZONE_ABSENT = 0x1E
ADDRESSABLE_ZONES = {2, 3, 7}

ZONE_NAMES = [
    "RGB LED 1 Header",
    "RGB LED 2 Header",
    "Addressable Header 1",
    "Addressable Header 2",
    "PCH",
    "IO Cover",
    "PCB",
    "Addressable Header 3/Audio",
]

# OpenRGB mode name -> controller effect id.
EFFECTS = {
    "Off": 0x00, "Static": 0x01, "Breathing": 0x02, "Strobe": 0x03,
    "Spectrum Cycle": 0x04, "Random": 0x05, "Music": 0x06, "Wave": 0x07,
    "Spring": 0x08, "Stack": 0x09, "Cram": 0x0A, "Scan": 0x0B,
    "Neon": 0x0C, "Water": 0x0D, "Rainbow": 0x0E,
}
COLOURED_EFFECTS = {0x01, 0x02, 0x03}
EFFECT_NAMES = {v: k for k, v in EFFECTS.items()} | {
    0x0F: "Direct",
    0xE2: "Direct (stream)",
    0xE3: "Direct (stream)",
}

BOARD_DESCRIPTION = "ASRock Polychrome USB Device"
BOARD_DETECTOR = "ASRock Polychrome USB"


def is_controller(node):
    try:
        return f"HID_ID={HID_ID}" in Path(node, "device/uevent").read_text()
    except OSError:
        return False


def find_device(requested=None):
    if requested:
        # Never send these reports to some other HID device.
        if not is_controller(f"/sys/class/hidraw/{os.path.basename(requested)}"):
            raise Error(f"{requested} is not the ASRock LED Controller (26ce:01a2)")
        return requested
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        if is_controller(node):
            return "/dev/" + os.path.basename(node)
    raise Error("ASRock LED Controller (26ce:01a2) not found")


class Polychrome:
    TIMEOUT = 1.0

    def __init__(self, path, verbose=False):
        self.path = path
        self.verbose = verbose
        try:
            self.fd = os.open(path, os.O_RDWR)
        except PermissionError:
            raise Error(f"no permission to open {path} (run as root, or log in "
                        "locally so OpenRGB's udev rule grants access)") from None
        # Every open hidraw handle receives every input report, so replies meant
        # for another program (a running OpenRGB) can be queued here already.
        while select.select([self.fd], [], [], 0.02)[0]:
            os.read(self.fd, 64)

    def close(self):
        os.close(self.fd)

    def _request(self, cmd, arg, body=b"", match=None, timeout=TIMEOUT):
        # Report ID 0 followed by the 64-byte report; the kernel strips the ID.
        # Byte offsets are kept identical to OpenRGB's usb_buf.
        buf = bytearray(65)
        buf[1] = cmd
        buf[3] = arg
        buf[4:4 + len(body)] = body
        os.write(self.fd, bytes(buf))
        while select.select([self.fd], [], [], timeout)[0]:
            reply = os.read(self.fd, 64)
            if self.verbose:
                print(f"  0x{cmd:02x} {arg:02x} -> {reply[:12].hex(' ')}")
            if match is None or match(reply):
                return reply
        raise Error(f"no reply to command 0x{cmd:02x}")

    def read_header(self, cfg):
        return self._request(CMD_READ_HEADER, cfg, match=lambda r: r[3] == cfg)[4:]

    def write_header(self, cfg, data):
        self._request(CMD_WRITE_HEADER, cfg, data)

    def read_zone(self, zone):
        r = self._request(CMD_READ_ZONE, zone, match=lambda r: r[3] == zone)
        return r[4], bytes(r[5:8]), r[8]  # effect, colour bytes as stored, speed

    def set_zone(self, zone, effect, wire_colour, speed):
        body = bytes([effect, *wire_colour, speed, 0xFF])
        self._request(CMD_SET_ZONE, zone, body)

    def commit(self):
        # Flash write; give it longer than a normal transfer.
        self._request(CMD_COMMIT, 0, timeout=3.0)


@dataclass
class Layout:
    zones: list      # hardware zone ids present, in OpenRGB's zone order
    counts: list     # 8 LED-count bytes
    rgswap: int      # rgswap bitmask


def read_layout(dev):
    available = dev.read_header(CFG_AVAILABLE)[0]
    counts = list(dev.read_header(CFG_LEDCOUNT)[:8])
    rgswap = dev.read_header(CFG_RGSWAP)[0]
    zones = [z for z in range(8) if counts[z] != ZONE_ABSENT and available >> z & 1]
    return Layout(zones, counts, rgswap)


def split_rgb(c):
    # OpenRGB stores colours as 0x00BBGGRR.
    return c & 0xFF, (c >> 8) & 0xFF, (c >> 16) & 0xFF


def to_wire(rgb, swapped):
    r, g, b = rgb
    return (r, g, b) if swapped else (g, r, b)


def from_wire(raw, swapped):
    a, b, c = raw
    return (a, b, c) if swapped else (b, a, c)


def hexcolour(rgb):
    return "#{:02X}{:02X}{:02X}".format(*rgb)


@dataclass
class ZonePlan:
    zone: int
    leds: int
    effect: int
    rgb: tuple
    speed: int
    swapped: bool


def build_plan(ctrl, layout, settings):
    notes = []
    mode = ctrl["modes"][ctrl["active_mode"]]
    if mode["name"] == "Direct":
        effect = EFFECTS["Static"]
        notes.append("profile uses Direct mode, which the controller cannot store; "
                     "saving it as Static (one colour per zone)")
    elif mode["name"] in EFFECTS:
        effect = EFFECTS[mode["name"]]
    else:
        raise Error(f"unsupported board mode {mode['name']!r} in profile")
    speed = max(0, min(255, int(mode.get("speed", 0))))

    pzones = ctrl["zones"]
    if len(pzones) != len(layout.zones):
        raise Error(f"profile has {len(pzones)} ASRock zones but the controller "
                    f"reports {len(layout.zones)}; re-save the profile in OpenRGB")

    # Same rule as OpenRGB: swapped if the controller says so or settings ask for it.
    rgswap_cfg = settings.get(BOARD_DETECTOR, {}).get("RGSwap", {})
    swapped = [bool(layout.rgswap >> z & 1) or bool(rgswap_cfg.get(ZONE_NAMES[z], False))
               for z in range(8)]

    colours = ctrl["colors"]
    plans, counts, offset = [], list(layout.counts), 0
    for pz, hz in zip(pzones, layout.zones):
        n = pz["leds_count"]
        zone_colours = colours[offset:offset + n]
        offset += n
        if hz in ADDRESSABLE_ZONES:
            counts[hz] = n
        if n == 0:
            continue  # nothing connected; OpenRGB skips these too
        if effect in COLOURED_EFFECTS and len(set(zone_colours)) > 1:
            notes.append(f"{ZONE_NAMES[hz]}: LEDs have different colours; the controller "
                         "stores one colour per zone, using LED 1's")
        plans.append(ZonePlan(hz, n, effect, split_rgb(zone_colours[0]), speed, swapped[hz]))

    rgswap = sum(1 << z for z in range(8) if swapped[z])
    return plans, counts, rgswap, notes


def board_status(args):
    path = find_device(args.device)
    dev = Polychrome(path, args.verbose)
    try:
        layout = read_layout(dev)
        print(f"Board, {path}:")
        print(f"  {'zone':<28}{'LEDs':>5}  {'effect':<17}{'colour':<9}{'speed':>5}  rg-swap")
        for z in layout.zones:
            effect, raw, speed = dev.read_zone(z)
            swapped = bool(layout.rgswap >> z & 1)
            name = EFFECT_NAMES.get(effect, f"0x{effect:02x}")
            print(f"  {ZONE_NAMES[z]:<28}{layout.counts[z]:>5}  {name:<17}"
                  f"{hexcolour(from_wire(raw, swapped)):<9}{speed:>5}  {'yes' if swapped else 'no'}")
    finally:
        dev.close()


def apply_board(ctrl, settings, args):
    path = find_device(args.device)
    dev = Polychrome(path, args.verbose)
    try:
        layout = read_layout(dev)
        plans, counts, rgswap, notes = build_plan(ctrl, layout, settings)
        print(f"Board, {path}:")
        for n in notes:
            print(f"  note: {n}")
        for p in plans:
            colour = hexcolour(p.rgb) if p.effect in COLOURED_EFFECTS else "-"
            print(f"  {ZONE_NAMES[p.zone]:<28}{EFFECT_NAMES[p.effect]:<16}{colour:<9}"
                  f"speed {p.speed}")
        if args.dry_run:
            return

        if counts != layout.counts:
            dev.write_header(CFG_LEDCOUNT, bytes(counts))
        dev.write_header(CFG_RGSWAP, bytes([rgswap]))
        for p in plans:
            dev.set_zone(p.zone, p.effect, to_wire(p.rgb, p.swapped), p.speed)
        dev.commit()

        mismatches = []
        if dev.read_header(CFG_RGSWAP)[0] != rgswap:
            mismatches.append("rg-swap")
        for p in plans:
            effect, raw, speed = dev.read_zone(p.zone)
            if (effect, raw, speed) != (p.effect, bytes(to_wire(p.rgb, p.swapped)), p.speed):
                mismatches.append(ZONE_NAMES[p.zone])
        if mismatches:
            raise Error("committed, but read-back differs for: " + ", ".join(mismatches))
        print("  committed to controller flash; read-back matches")
    finally:
        dev.close()


# --------------------------------------------------------------------------- #
# ENE SMBus RAM controllers
# --------------------------------------------------------------------------- #

I2C_SLAVE = 0x0703
I2C_SMBUS = 0x0720
SMBUS_WRITE, SMBUS_READ = 0, 1
SMBUS_BYTE_DATA, SMBUS_WORD_DATA = 2, 3

# OpenRGB's ene_ram_addresses. Nothing else on this bus is ever addressed: the
# DDR5 SPD hubs (0x50-0x57) and the PMICs that set memory voltage share it.
ENE_RAM_ADDRESSES = range(0x70, 0x78)
ENE_RAM_NAMES = ("DIMM_LED-", "AUDA0-", "AUMA0-")  # OpenRGB's RAM controller versions

ENE_REG_DEVICE_NAME = 0x1000
ENE_REG_DIRECT = 0x8020
ENE_REG_MODE = 0x8021
ENE_REG_APPLY = 0x80A0
ENE_SAVE_VAL = 0xAA

RAM_DESCRIPTION = "ENE SMBus Device"
DEVICE_TYPE_DRAM = 1
MODE_COLORS_RANDOM = 3

# OpenRGB mode name -> ENE mode register value, and the value OpenRGB uses
# instead when the mode is set to random colours.
ENE_MODES = {
    "Off": 0, "Static": 1, "Breathing": 2, "Flashing": 3, "Spectrum Cycle": 4,
    "Rainbow": 5, "Chase Fade": 7, "Chase": 9, "Random Flicker": 13, "Double Fade": 14,
}
ENE_RANDOM_MODES = {2: 6, 7: 8, 9: 10}
ENE_MODE_NAMES = {v: k for k, v in ENE_MODES.items()} | {
    6: "Breathing (random)", 8: "Chase Fade (random)", 10: "Chase (random)",
    11: "Wave", 12: "Rainbow Pulse",
}

LOCATION_RE = re.compile(r"I2C: (.+) \(/dev/i2c-\d+\), address 0x([0-9A-Fa-f]{2})$")


class _SMBusData(ctypes.Union):
    _fields_ = [("byte", ctypes.c_uint8), ("word", ctypes.c_uint16),
                ("block", ctypes.c_uint8 * 34)]


class _SMBusIoctl(ctypes.Structure):
    _fields_ = [("read_write", ctypes.c_uint8), ("command", ctypes.c_uint8),
                ("size", ctypes.c_uint32), ("data", ctypes.POINTER(_SMBusData))]


class EneRam:
    """One ENE RAM RGB controller, driven exactly as OpenRGB's i2c_smbus interface does."""

    def __init__(self, bus, address):
        if address not in ENE_RAM_ADDRESSES:
            raise Error(f"refusing SMBus address 0x{address:02x}: not an ENE RAM address")
        self.address = address
        try:
            self.fd = os.open(bus, os.O_RDWR)
        except OSError as e:
            raise Error(f"cannot open {bus}: {e.strerror}") from None
        try:
            fcntl.ioctl(self.fd, I2C_SLAVE, address)  # EBUSY if a kernel driver owns it
        except OSError as e:
            os.close(self.fd)
            raise Error(f"0x{address:02x} on {bus}: {e.strerror}") from None

    def close(self):
        os.close(self.fd)

    def _smbus(self, read_write, command, size, data):
        fcntl.ioctl(self.fd, I2C_SMBUS,
                    _SMBusIoctl(read_write, command, size, ctypes.pointer(data)))

    def _read_byte_data(self, command):
        data = _SMBusData()
        self._smbus(SMBUS_READ, command, SMBUS_BYTE_DATA, data)
        return data.byte

    def _write_word_data(self, command, word):
        self._smbus(SMBUS_WRITE, command, SMBUS_WORD_DATA, _SMBusData(word=word))

    def _write_byte_data(self, command, value):
        self._smbus(SMBUS_WRITE, command, SMBUS_BYTE_DATA, _SMBusData(byte=value))

    def _select(self, reg):
        self._write_word_data(0x00, ((reg << 8) & 0xFF00) | ((reg >> 8) & 0xFF))

    def reg_read(self, reg):
        self._select(reg)
        return self._read_byte_data(0x81)

    def reg_write(self, reg, value):
        self._select(reg)
        self._write_byte_data(0x01, value)

    def identify(self):
        """The controller's name if this is an ENE RAM controller, else None.

        The first check is OpenRGB's detection signature (registers 0xA0-0xAF
        read back 0..15) and only reads; the name is what OpenRGB reads to
        tell ENE controller versions apart.
        """
        try:
            if any(self._read_byte_data(0xA0 + i) != i for i in range(16)):
                return None
            raw = bytes(self.reg_read(ENE_REG_DEVICE_NAME + i) for i in range(16))
        except OSError:
            return None
        name = raw.split(b"\0")[0].decode("ascii", "replace")
        return name if name.startswith(ENE_RAM_NAMES) else None


@dataclass
class RamStick:
    adapter: str
    address: int
    mode: str
    expected: int | None  # ENE mode register value the profile should leave behind


def ram_sticks(data):
    sticks = []
    for ctrl in data.get("controllers", []):
        if ctrl.get("description") != RAM_DESCRIPTION or ctrl.get("type") != DEVICE_TYPE_DRAM:
            continue
        m = LOCATION_RE.match(ctrl.get("location", ""))
        if not m:
            continue
        mode = ctrl["modes"][ctrl["active_mode"]]
        expected = ENE_MODES.get(mode["name"])
        if expected is not None and mode.get("color_mode") == MODE_COLORS_RANDOM:
            expected = ENE_RANDOM_MODES.get(expected, expected)
        sticks.append(RamStick(m.group(1), int(m.group(2), 16), mode["name"], expected))
    return sticks


def find_i2c_bus(adapter_name):
    # Bus numbers change between boots; the adapter name does not.
    for node in sorted(glob.glob("/sys/class/i2c-dev/i2c-*")):
        try:
            if Path(node, "name").read_text().strip() == adapter_name:
                return "/dev/" + os.path.basename(node)
        except OSError:
            continue
    raise Error(f"SMBus adapter {adapter_name!r} not found")


def openrgb_running():
    for comm in glob.glob("/proc/[0-9]*/comm"):
        try:
            if Path(comm).read_text().strip() == "openrgb":
                return True
        except OSError:
            continue
    return False


def load_with_openrgb(config_dir, profile):
    """Have OpenRGB's command line program the profile into every device."""
    cmd = ["openrgb", "--noautoconnect", "--config", str(config_dir), "--profile", profile.stem]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        raise Error("openrgb is not installed") from None
    except subprocess.TimeoutExpired:
        raise Error("OpenRGB did not finish loading the profile within 2 minutes") from None
    output = (r.stdout + r.stderr).strip()
    if r.returncode != 0 or "Profile loaded successfully" not in output:
        raise Error("OpenRGB could not load the profile:\n" + output[-800:])


def open_stick(stick):
    ene = EneRam(find_i2c_bus(stick.adapter), stick.address)
    name = ene.identify()
    if name is None:
        ene.close()
        raise Error(f"0x{stick.address:02x}: no ENE RAM controller answers there")
    return ene, name


def save_ram(sticks):
    errors = []
    print("RAM:")
    for s in sticks:
        try:
            ene, name = open_stick(s)
            try:
                if ene.reg_read(ENE_REG_DIRECT):
                    raise Error(f"0x{s.address:02x}: still in Direct mode; not saving")
                mode = ene.reg_read(ENE_REG_MODE)
                if mode != s.expected:
                    raise Error(f"0x{s.address:02x}: holds "
                                f"{ENE_MODE_NAMES.get(mode, mode)!s}, not the profile's "
                                f"{s.mode}; not saving")
                ene.reg_write(ENE_REG_APPLY, ENE_SAVE_VAL)
            finally:
                ene.close()
            print(f"  0x{s.address:02x}  {name:<18}{s.mode:<16}saved to the stick")
        except (Error, OSError) as e:
            errors.append(f"RAM {e}")
    return errors


def ram_status(sticks):
    print("RAM:")
    if openrgb_running():
        print("  not read while OpenRGB is running (it uses the same bus)")
        return
    for s in sticks:
        try:
            ene, name = open_stick(s)
            try:
                direct = ene.reg_read(ENE_REG_DIRECT)
                mode = ene.reg_read(ENE_REG_MODE)
            finally:
                ene.close()
            label = "Direct" if direct else ENE_MODE_NAMES.get(mode, f"0x{mode:02x}")
            print(f"  0x{s.address:02x}  {name:<18}{label}")
        except (Error, OSError) as e:
            print(f"  {e}")


# --------------------------------------------------------------------------- #
# OpenRGB profile handling
# --------------------------------------------------------------------------- #

def config_dir_of(args):
    if args.config_dir:
        return Path(args.config_dir)
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / "OpenRGB"


def load_settings(config_dir):
    try:
        return json.loads((config_dir / "OpenRGB.json").read_text())
    except (OSError, ValueError):
        return {}


def pick_profile(config_dir, settings, name):
    profiles = config_dir / "profiles"
    if name:
        p = Path(name)
        return p if p.is_file() else profiles / f"{name}.json"
    # The profile OpenRGB loads at start-up is the one meant to be "the" lighting.
    pm = settings.get("ProfileManager", {})
    for key in ("open_profile", "service_startup_profile"):
        entry = pm.get(key) or {}
        if entry.get("enabled") and entry.get("name"):
            return profiles / f"{entry['name']}.json"
    candidates = sorted(profiles.glob("*.json"), key=lambda p: p.stat().st_mtime)
    if not candidates:
        raise Error(f"no OpenRGB profiles in {profiles}")
    return candidates[-1]


def load_profile(path):
    try:
        return json.loads(path.read_text())
    except OSError as e:
        raise Error(f"cannot read profile: {e.strerror}: {path}") from None
    except ValueError:
        raise Error(f"{path} is not a JSON profile (OpenRGB 1.x format needed)") from None


def find_board(data):
    for ctrl in data.get("controllers", []):
        if ctrl.get("description") == BOARD_DESCRIPTION:
            return ctrl
    return None


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

def cmd_status(args):
    errors = []
    try:
        board_status(args)
    except (Error, OSError) as e:
        errors.append(f"board: {e}")
    config_dir = config_dir_of(args)
    try:
        data = load_profile(pick_profile(config_dir, load_settings(config_dir), None))
        if sticks := ram_sticks(data):
            ram_status(sticks)
    except Error as e:
        errors.append(f"RAM: {e}")
    return errors


def cmd_apply(args):
    config_dir = config_dir_of(args)
    settings = load_settings(config_dir)
    profile = pick_profile(config_dir, settings, args.profile)
    data = load_profile(profile)
    board = find_board(data)
    sticks = ram_sticks(data)
    if board is None and not sticks:
        raise Error(f"{profile} has neither the ASRock board nor ENE RAM in it")
    print(f"Profile {profile}")

    errors = []
    to_save = []
    for s in sticks:
        if s.expected is None:
            errors.append(f"RAM 0x{s.address:02x}: {s.mode} mode can't be saved to the "
                          "stick; switch it to Static (or another effect) in OpenRGB")
        else:
            to_save.append(s)

    # OpenRGB rewrites every device, the board included, so it runs first.
    if to_save:
        if openrgb_running():
            errors.append("RAM: close OpenRGB first; it uses the same bus, so the RAM "
                          "was left alone")
            to_save = []
        elif profile.parent.resolve() != (config_dir / "profiles").resolve():
            errors.append("RAM: the profile must be in OpenRGB's profiles folder")
            to_save = []
        elif args.dry_run:
            print("RAM: would load the profile with OpenRGB, then save it to the "
                  "sticks at " + ", ".join(f"0x{s.address:02x}" for s in to_save))
            to_save = []
        else:
            print("RAM: loading the profile with OpenRGB ...")
            try:
                load_with_openrgb(config_dir, profile)
            except Error as e:
                errors.append(f"RAM: {e}")
                to_save = []

    if board is not None:
        try:
            apply_board(board, settings, args)
        except (Error, OSError) as e:
            errors.append(f"board: {e}")

    if to_save:
        errors += save_ram(to_save)
    return errors


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--config-dir", help="OpenRGB config dir (default: ~/.config/OpenRGB)")
    ap.add_argument("--device", help="board hidraw node (default: auto-detect 26ce:01a2)")
    ap.add_argument("-v", "--verbose", action="store_true", help="print raw board replies")
    sub = ap.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="show what the board and RAM currently hold")

    a = sub.add_parser("apply", help="save a profile into the board and the RAM")
    a.add_argument("--profile", help="profile name or path (default: OpenRGB's "
                   "start-up profile, else the newest one)")
    a.add_argument("-n", "--dry-run", action="store_true", help="show the plan, write nothing")

    args = ap.parse_args()
    try:
        errors = {"status": cmd_status, "apply": cmd_apply}[args.command](args)
    except (Error, OSError) as e:
        errors = [str(e)]
    for e in errors:
        print(f"error: {e}", file=sys.stderr)
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
